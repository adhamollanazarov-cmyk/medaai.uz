# ===== meda.ai — shared configuration (Node API + aiogram bot) =====

# --- Database (shared by both services) ---
# docker-compose uses the value below as-is.
DATABASE_URL=postgresql://medauz:medauz@localhost:5432/medauz

# --- Telegram bot (aiogram) ---
BOT_TOKEN=
# Public HTTPS base URL (used as fallback for the Mini App button: PUBLIC_URL + /app).
# Local tunnel: npx localtunnel --port 3000  (or ngrok http 3000)
PUBLIC_URL=
# Full Mini App URL when the frontend is hosted separately (e.g. Vercel):
#   MINIAPP_URL=https://your-app.vercel.app/webapp
MINIAPP_URL=
# Comma-separated Telegram user IDs allowed to see /admin analytics.
# Find your id via @userinfobot.
ADMIN_IDS=

# --- Node API ---
PORT=3000
CLINIC_DASHBOARD_TOKEN=clinic-demo-2026

# --- AI matching ---
# Works WITHOUT a key (offline rule-based matcher, $0). Set a key to use an LLM.
# The matcher speaks the OpenAI-compatible format, so both providers work —
# only these 3 lines change.
#
# OpenAI / GPT (what you have credits for now):
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Claude (later — Anthropic's OpenAI-compatible endpoint):
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
