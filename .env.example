# ===== meda.ai — shared configuration (Node API + aiogram bot) =====

# --- Database (shared by both services) ---
# docker-compose uses the value below as-is.
DATABASE_URL=postgresql://medauz:medauz@localhost:5432/medauz

# --- Telegram bot (aiogram) ---
BOT_TOKEN=
# Public HTTPS base URL (used as fallback for the Mini App button: PUBLIC_URL + /app).
# Local tunnel: npx localtunnel --port 3000  (or ngrok http 3000)
PUBLIC_URL=
# Full Mini App URL when the frontend is hosted separately (e.g. Vercel):
#   MINIAPP_URL=https://your-app.vercel.app/webapp
MINIAPP_URL=
# Comma-separated Telegram user IDs allowed to see /admin analytics.
# Find your id via @userinfobot.
ADMIN_IDS=

# Адрес Node API для бота. По умолчанию берётся PUBLIC_URL, а локально —
# http://localhost:3000. Задавайте явно, только если API живёт отдельно.
API_BASE=

# --- Node API ---
PORT=3000
# Один и тот же токен для веб-кабинета клиники И для админ-панели бота:
# бот им авторизует добавление/редактирование врачей.
CLINIC_DASHBOARD_TOKEN=clinic-demo-2026

# --- AI matching ---
# Works WITHOUT a key (offline rule-based matcher, $0). Set a key to use an LLM.
# The matcher speaks the OpenAI-compatible format, so both providers work —
# only these 3 lines change.
#
# OpenAI / GPT (what you have credits for now):
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Claude (later — Anthropic's OpenAI-compatible endpoint):
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- AI consultation (multi-turn chat) ---
# Uses the SAME LLM_* keys above. With no key the chat tab is hidden in the
# Mini App and /chat in the bot falls back to the offline rule-based matcher.
# The bot reaches the chat endpoint at PUBLIC_URL (or http://localhost:3000).

# --- Doctor photos ---
# Фото врача загружается в боте и хранится как Telegram file_id. Чтобы Mini App
# мог его показать, API резолвит file_id через Telegram — для этого сервису API
# тоже нужен BOT_TOKEN (тот же самый). Без него фото просто не отображается,
# всё остальное работает.
